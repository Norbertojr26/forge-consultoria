generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

model User {
  id               String    @id // Clerk userId
  email            String    @unique
  name             String?
  birthDate        DateTime? @db.Date
  heightCm         Int?
  goal             String? // "hipertrofia" | "cutting" | "recomp" | ...
  sex              Sex? // define o personagem (masculino/feminino) das imagens de exercício
  // Frequência do check-in definida pelo treinador: 7 (semanal), 10 ou 14 (quinzenal) dias
  checkInEveryDays Int       @default(7)
  role             Role      @default(STUDENT)
  createdAt        DateTime  @default(now())
  checkIns         CheckIn[] @relation("CheckInOwner")

  // Aluno -> treinador responsável (equipe com vários treinadores)
  trainerId String?
  trainer   User?   @relation("TrainerStudents", fields: [trainerId], references: [id], onDelete: SetNull)
  students  User[]  @relation("TrainerStudents")

  workoutPlans     WorkoutPlan[]    @relation("PlanStudent")
  feedbackGiven    CheckIn[]        @relation("CheckInFeedback")
  dietPlans        DietPlan[]       @relation("DietStudent")
  createdFoods     Food[]
  dietTemplates    DietTemplate[]
  authoredDiets    DietPlan[]       @relation("DietTrainer")
  waterLogs        WaterLog[]
  dailyChecks      DailyCheck[]
  authoredPlans    WorkoutPlan[]    @relation("PlanTrainer")
  workoutSessions  WorkoutSession[]
  createdExercises Exercise[]
  routine          Routine?         @relation("RoutineStudent")
  cardioLogs       CardioLog[]
  sleepLogs        SleepLog[]

  @@index([trainerId])
}

model CheckIn {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("CheckInOwner", fields: [userId], references: [id], onDelete: Cascade)
  weekOf         DateTime  @db.Date // domingo da semana no fuso America/Sao_Paulo
  date           DateTime  @db.Date // dia do envio (São Paulo); base da frequência de 10/14 dias
  weightKg       Float
  mood           Int // 1-5
  notes          String?
  photoFront     String? // chave do objeto no bucket (não URL); URL assinada gerada na leitura
  photoBack      String?
  // Medidas opcionais (cm) e % de gordura
  waistCm        Float?
  hipCm          Float?
  chestCm        Float?
  armCm          Float?
  thighCm        Float?
  bodyFatPct     Float?
  // Retorno do treinador
  feedback       String?
  feedbackAt     DateTime?
  feedbackById   String?
  feedbackBy     User?     @relation("CheckInFeedback", fields: [feedbackById], references: [id], onDelete: SetNull)
  feedbackSeenAt DateTime? // aluno marcou como lido
  createdAt      DateTime  @default(now())

  @@unique([userId, weekOf])
}

// ─── Treino ────────────────────────────────────────────────

model Exercise {
  id           String        @id @default(cuid())
  name         String        @unique
  muscleGroup  String // "peito" | "costas" | ... (ver lib/exercises.ts)
  equipment    String? // "barra" | "halter" | "máquina" | ...
  instructions String?
  imageKey     String? // imagem enviada manualmente pelo treinador (tem prioridade sobre tudo)
  videoKey     String? // vídeo de execução enviado pelo treinador (tem prioridade sobre o da IA)
  // id na Free Exercise DB (domínio público): fotos reais em /public/exercises/<sourceId>/0.jpg e 1.jpg,
  // usadas enquanto não há imagem própria e como referência de pose para gerar a nova
  sourceId     String?       @unique
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  items        WorkoutItem[]
  arts         ExerciseArt[]

  @@index([muscleGroup])
}

enum Sex {
  MALE
  FEMALE
}

/// Imagens no padrão FORGE geradas por IA: posição inicial e final, por versão do personagem.
/// Uma proposta (approved=false) e uma aprovada (approved=true) por exercício e sexo.
model ExerciseArt {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sex        Sex
  approved   Boolean  @default(false)
  startKey   String
  endKey     String?
  videoKey   String? // clipe em loop gerado por IA a partir de início → fim
  createdAt  DateTime @default(now())

  @@unique([exerciseId, sex, approved])
}

/// Configurações simples chave/valor (ex.: imagem-mestre do personagem por sexo).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model WorkoutPlan {
  id        String       @id @default(cuid())
  name      String
  notes     String?
  active    Boolean      @default(true) // só um plano ativo por aluno; os outros ficam no histórico
  studentId String
  student   User         @relation("PlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   User?        @relation("PlanTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  sentAt    DateTime? // null = rascunho, aluno ainda não vê
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  days      WorkoutDay[]

  @@index([studentId, active])
}

model WorkoutDay {
  id       String           @id @default(cuid())
  planId   String
  plan     WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  name     String // "Treino A — Peito e tríceps"
  order    Int
  items    WorkoutItem[]
  sessions WorkoutSession[]

  @@index([planId, order])
}

model WorkoutItem {
  id          String     @id @default(cuid())
  dayId       String
  day         WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order       Int
  sets        Int
  reps        String // "10" | "8-12" | "até a falha"
  loadKg      Float?
  restSeconds Int        @default(60)
  targetRir   Int? // alvo de repetições na reserva (0 = falha … 4)
  notes       String?
  setLogs     SetLog[]

  @@index([dayId, order])
}

model WorkoutSession {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId      String
  day        WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  setLogs    SetLog[]

  @@index([userId, startedAt])
}

model SetLog {
  id          String         @id @default(cuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId      String
  item        WorkoutItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  setNumber   Int
  reps        Int?
  loadKg      Float?
  rir         Int? // repetições que ainda daria (RPE = 10 − RIR)
  exerciseId  String? // cópia do exercício do item: o histórico sobrevive à troca de plano
  completedAt DateTime       @default(now())

  @@unique([sessionId, itemId, setNumber])
  @@index([exerciseId])
}

// ─── Dieta, suplementos e hidratação ─────────────────────

/// Plano alimentar montado pelo treinador. Como no treino, o aluno tem um ativo por vez.
model DietPlan {
  id          String       @id @default(cuid())
  name        String
  notes       String?
  active      Boolean      @default(false)
  sentAt      DateTime?
  studentId   String
  student     User         @relation("DietStudent", fields: [studentId], references: [id], onDelete: Cascade)
  trainerId   String?
  trainer     User?        @relation("DietTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  // Metas diárias (opcionais). Sem waterGoalMl, a meta de água é 35 ml × peso.
  kcalTarget  Int?
  proteinG    Int?
  carbsG      Int?
  fatG        Int?
  waterGoalMl Int?
  meals       Meal[]
  supplements Supplement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([studentId, active])
}

model Meal {
  id       String     @id @default(cuid())
  planId   String
  plan     DietPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  name     String // "Café da manhã"
  time     String? // "07:30"
  order    Int
  notes    String?
  imageKey String? // prato no padrão FORGE (gerado por IA)
  items    MealItem[]
}

model MealItem {
  id            String  @id @default(cuid())
  mealId        String
  meal          Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  order         Int
  food          String // "Arroz branco"
  quantity      String // "150 g", "2 unidades"
  kcal          Int?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  substitutions String? // "ou batata-doce 200 g"
  // Alimento do banco (opcional): com gramas, kcal e macros são calculados por 100 g
  foodId        String?
  catalogFood   Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  grams         Float?
}

enum SupplementKind {
  SUPPLEMENT
  MEDICATION
}

/// Suplemento ou medicação com horários. Medicação só como lembrete do que o médico prescreveu.
model Supplement {
  id     String         @id @default(cuid())
  planId String
  plan   DietPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind   SupplementKind @default(SUPPLEMENT)
  name   String // "Creatina"
  dose   String // "5 g"
  times  String[] // ["08:00", "22:00"]
  notes  String?
  order  Int
}

/// Copos de água registrados pelo aluno (soma por dia no fuso de São Paulo).
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/// Marcação do dia: refeição feita (MEAL) ou dose tomada (SUPPLEMENT, por horário em slot).
model DailyCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String // "MEAL" | "SUPPLEMENT" | "MOBILITY"
  refId     String // id da refeição, do suplemento ou da rotina (mobilidade)
  slot      String   @default("") // horário da dose ("08:00"); vazio para refeição
  createdAt DateTime @default(now())

  @@unique([userId, date, kind, refId, slot])
}

/// Banco de alimentos: TACO (NEPA/UNICAMP) + cadastrados pela equipe. Valores por 100 g.
model Food {
  id                String     @id @default(cuid())
  name              String     @unique
  category          String
  kcal              Float
  proteinG          Float
  carbsG            Float
  fatG              Float
  fiberG            Float?
  sodiumMg          Float?
  // Porção caseira opcional: "1 unidade" = unitGrams g
  unitName          String?
  unitGrams         Float?
  tags              String[] // sem_lactose, sem_gluten, vegetariano, vegano
  imageKey          String? // foto no padrão FORGE (aprovada ou enviada)
  imageCandidateKey String? // foto gerada por IA aguardando aprovação
  source            String     @default("CUSTOM") // "TACO" | "CUSTOM"
  tacoId            Int?       @unique
  createdById       String?
  createdBy         User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  mealItems         MealItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([category])
}

/// Kit de dieta (modelo) para montar dietas de alunos. content = metas, refeições e suplementos.
model DietTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  tags        String[]
  content     Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Cardio, sono e mobilidade ───────────────────────────

/// Rotina complementar prescrita pelo treinador: meta de sono, cardio e mobilidade.
/// Uma por aluno, editável a qualquer momento (vale na hora para o aluno).
model Routine {
  id              String               @id @default(cuid())
  studentId       String               @unique
  student         User                 @relation("RoutineStudent", fields: [studentId], references: [id], onDelete: Cascade)
  sleepGoalHours  Float?
  bedtime         String? // horário-alvo para deitar ("23:00")
  sleepNotes      String?
  mobilityPerWeek Int? // dias por semana da rotina de mobilidade
  mobilityNotes   String?
  cardio          CardioPrescription[]
  mobility        MobilityDrill[]
  updatedAt       DateTime             @updatedAt
}

/// Cardio prescrito: tipo (LISS, Z2, HIIT, OUTRO), modalidade, duração e vezes por semana.
model CardioPrescription {
  id          String  @id @default(cuid())
  routineId   String
  routine     Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  order       Int
  kind        String // "LISS" | "Z2" | "HIIT" | "OUTRO"
  modality    String // "Esteira inclinada", "Bike"
  durationMin Int
  perWeek     Int
  intensity   String? // "FC 120–135 bpm" | "10× 30s forte / 90s leve"
  notes       String?
}

/// Exercício da rotina de mobilidade ("Rotação torácica — 2×10 cada lado").
model MobilityDrill {
  id           String  @id @default(cuid())
  routineId    String
  routine      Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  prescription String
  notes        String?
}

/// Cardio feito pelo aluno. prescriptionId liga ao prescrito (texto copiado sobrevive à edição).
model CardioLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  prescriptionId String?
  kind           String
  modality       String
  durationMin    Int
  distanceKm     Float?
  avgHr          Int?
  rpe            Int? // esforço percebido 1–10
  notes          String?
  createdAt      DateTime @default(now())

  @@index([userId, date])
}

/// Noite de sono, registrada no dia em que o aluno acordou (fuso de São Paulo).
model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  bedtime   String // "23:15"
  wakeTime  String // "06:40"
  hours     Float
  quality   Int // 1–5
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}
