# ─── Clerk ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/aluno
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/aluno/perfil

# ─── Banco (Railway Postgres) ─────────────────────────────
# Railway: ${{Postgres.DATABASE_URL}}  ·  Local: valor de DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ─── Fotos (Railway Bucket, compatível com S3) ────────────
# No Railway, use referências às variáveis do bucket (aba Credentials):
#   S3_ENDPOINT=${{Bucket.ENDPOINT}}  S3_BUCKET=${{Bucket.BUCKET}}  S3_REGION=${{Bucket.REGION}}
#   S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}  S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_ENDPOINT=https://endpoint-do-bucket
S3_REGION=auto
S3_BUCKET=forge-checkins
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
# "true" se a aba Credentials do bucket indicar URLs path-style
S3_FORCE_PATH_STYLE=false

# ─── Equipe ───────────────────────────────────────────────
# E-mails que entram como administrador (separados por vírgula)
ADMIN_EMAILS=voce@exemplo.com

# Geração das imagens de exercício no padrão FORGE (OpenRouter). Sem a chave, o botão fica desativado.
OPENROUTER_API_KEY=
# Opcional: modelo de imagem (padrão google/gemini-2.5-flash-image)
OPENROUTER_IMAGE_MODEL=
